{
  "name": "qq-agents",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Self-hosted console for multiple AI personas on QQ (NapCat/OneBot) with DSH, Codex or any OpenAI-compatible API",
  "keywords": [
    "qq",
    "onebot",
    "napcat",
    "ai-agent",
    "chatbot",
    "mcp",
    "openai"
  ],
  "homepage": "https://github.com/wangyufengsky/qq-agents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangyufengsky/qq-agents.git"
  },
  "bugs": {
    "url": "https://github.com/wangyufengsky/qq-agents/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/main.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "privacy-scan": "node scripts/privacy-scan.mjs",
    "mcp": "node src/mcp.mjs",
    "migrate": "node scripts/migrate.mjs",
    "export": "node scripts/export.mjs",
    "dsh:bundle": "node scripts/dsh-bundle.mjs",
    "format:check": "prettier --check src public scripts test docs examples README.md NOTICE.md package.json eslint.config.mjs tsconfig.json .github",
    "format": "prettier --write src public scripts test docs examples README.md NOTICE.md package.json eslint.config.mjs tsconfig.json .github",
    "verify": "npm run check && npm run lint && npm run typecheck && npm run defaults:check && npm test && npm run format:check && npm run privacy-scan",
    "acceptance:live": "node scripts/local-acceptance.mjs",
    "memory:benchmark": "node scripts/memory-benchmark.mjs",
    "memory:backup": "node scripts/backup.mjs",
    "lint": "eslint src scripts test eslint.config.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "defaults:check": "node scripts/default-config.mjs",
    "defaults:write": "node scripts/default-config.mjs --write",
    "scheduling:benchmark": "node scripts/scheduling-benchmark.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "js-yaml": "5.5.0",
    "playwright-core": "1.64.1",
    "saxes": "6.0.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  },
  "files": [
    "src",
    "public",
    "vendor",
    "docs",
    "NOTICE.md"
  ]
}
